RewriteEngine On

# FORCE WWW
RewriteCond %{HTTP_HOST} ^coreoutsourcingservices\.in [NC]
RewriteRule ^(.*)$ https://www.coreoutsourcingservices.in/$1 [L,R=301]

# REMOVE index.html
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# BLOG DETAIL URL
RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ /blog-detaile.html [L,QSA]

# REMOVE .html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [L]